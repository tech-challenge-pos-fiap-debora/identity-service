# Copia para .env (na raiz). O Docker Compose usa este ficheiro para interpolar
# variáveis no docker-compose.yml (serviço identity).
#
# Na máquina host (yarn migrate:up / yarn start:dev / testes):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/identity
#
# Dentro da rede do compose, o serviço identity já usa o host `postgres`
# do compose. No Kubernetes o host é `identity-postgres`:
# postgresql://postgres:postgres@identity-postgres:5432/identity

# Testes de integração com compose local (Postgres na porta 5433):
# INTEGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/identity

JWT_SECRET=altere-este-segredo
JWT_EXPIRES_IN=1d
PORT=3000
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin

# Observabilidade — carimbo fixo deste microsserviço (logs + New Relic)
SERVICE_NAME=identity-service
NEW_RELIC_APP_NAME=identity-service
NEW_RELIC_LABELS=service:identity-service;component:identity
# NEW_RELIC_LICENSE_KEY=
NEW_RELIC_ENABLED=false

